{
  "name": "@kairos/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p .",
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "worker": "tsx --env-file-if-exists=../../.env src/worker.ts",
    "build": "tsx scripts/build.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts",
    "db:copy-local": "tsx --env-file-if-exists=../../.env scripts/copy-local.ts",
    "smoke": "tsx --env-file-if-exists=../../.env scripts/smoke.ts"
  },
  "dependencies": {
    "@bufbuild/cel": "^0.6.1",
    "@hono/node-server": "^1.13.0",
    "@kairos/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "1.0.0-rc.5",
    "embedded-postgres": "18.4.0-beta.17",
    "hono": "^4.6.0",
    "pg": "^8.23.1",
    "ulid": "^3.0.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@finic-ai/kairos-edge": "workspace:*",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "1.0.0-rc.5",
    "esbuild": "^0.25.12"
  }
}

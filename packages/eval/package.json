{
  "name": "@kairos/eval",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p .",
    "generate": "tsx src/generate.ts",
    "eval": "tsx --env-file-if-exists=../../.env src/run.ts",
    "replay": "tsx --env-file-if-exists=../../.env src/replay.ts"
  },
  "dependencies": {
    "@kairos/core": "workspace:*"
  }
}

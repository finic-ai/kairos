{
  "name": "@finic-ai/kairos",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Kairos client: track financial events and request decisions.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./middleware": {
      "types": "./src/middleware.ts",
      "default": "./src/middleware.ts"
    },
    "./browser": {
      "types": "./src/browser.ts",
      "default": "./src/browser.ts"
    },
    "./routes": {
      "types": "./src/routes.ts",
      "default": "./src/routes.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@finic-ai/kairosid": "workspace:*",
    "@types/express": "^5.0.6",
    "express": "^5.3.0",
    "hono": "^4.13.13",
    "tsup": "^8.5.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/finic-ai/kairos.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/finic-ai/kairos/tree/main/packages/sdk",
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./middleware": {
        "types": "./dist/middleware.d.ts",
        "default": "./dist/middleware.js"
      },
      "./browser": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "./routes": {
        "types": "./dist/routes.d.ts",
        "default": "./dist/routes.js"
      }
    }
  }
}

{
  "provider": "lithic",
  "version": 1,
  "displayName": "Lithic",
  "category": "transaction_intelligence",
  "checked": false,
  "description": "Card transactions on the cards you issue: each authorization, clearing, decline and reversal, with the merchant and how the card was used.",
  "verification": {
    "scheme": "standard"
  },
  "secretHint": "The event subscription's secret, whsec_…",
  "setup": [
    "In the Lithic Dashboard, open Webhooks (or call POST /v1/event_subscriptions) and add a subscription with the URL below.",
    "Select the event type card_transaction.updated.",
    "Copy the subscription's secret (whsec_…) and paste it here.",
    "Lithic does not know your user id. Give each user the token of their Lithic account as a property: PUT /v1/objects with { \"type\": \"user\", \"id\": \"user_42\", \"properties\": { \"lithic_account_token\": \"…\" } }. Kairos finds the user from it."
  ],
  "identity": "Kairos finds the user whose lithic_account_token property is the transaction's account_token. Without that property, a transaction is stored on its Lithic account and card only.",
  "events": [
    "card_transaction.updated"
  ],
  "mapping": {
    "rules": [
      {
        "name": "Card transaction",
        "match": {
          "event_type": "card_transaction.updated"
        },
        "event": {
          "id": "$.events[-1].token",
          "type": "card_transaction",
          "ts": "$.updated",
          "entities": {
            "user": {
              "lookup": {
                "property": "lithic_account_token",
                "value": "$.account_token"
              }
            },
            "lithic_account": "$.account_token",
            "card": "$.card_token"
          },
          "universal_id": "$.token",
          "status": {
            "path": "$.status",
            "values": {
              "PENDING": "pending",
              "SETTLED": "completed",
              "DECLINED": "declined",
              "VOIDED": "voided",
              "EXPIRED": "expired"
            }
          },
          "properties": {
            "result": "$.result",
            "amount_minor": "$.amounts.cardholder.amount",
            "currency": "$.amounts.cardholder.currency",
            "merchant_amount_minor": "$.amounts.merchant.amount",
            "merchant_currency": "$.amounts.merchant.currency",
            "hold_minor": "$.amounts.hold.amount",
            "merchant": "$.merchant.descriptor",
            "merchant_id": "$.merchant.acceptor_id",
            "mcc": "$.merchant.mcc",
            "merchant_city": "$.merchant.city",
            "merchant_country": "$.merchant.country",
            "network": "$.network",
            "network_risk_score": "$.network_risk_score",
            "card_present": "$.pos.entry_mode.card",
            "cardholder_present": "$.pos.entry_mode.cardholder",
            "pan_entry": "$.pos.entry_mode.pan",
            "pin_entered": "$.pos.entry_mode.pin_entered",
            "wallet": "$.token_info.wallet_type",
            "three_ds_result": "$.cardholder_authentication.authentication_result",
            "liability_shift": "$.cardholder_authentication.liability_shift",
            "latest_event": "$.events[-1].type",
            "latest_event_result": "$.events[-1].result",
            "latest_event_amount_minor": "$.events[-1].amounts.cardholder.amount"
          }
        }
      }
    ]
  },

{
  "provider": "intercom",
  "version": 1,
  "displayName": "Intercom",
  "category": "customer_support",
  "checked": false,
  "description": "Messages that your users send to support: a new conversation and each reply, with the text.",
  "verification": { "scheme": "hmac", "header": "X-Hub-Signature", "algorithm": "sha1", "encoding": "hex", "prefix": "sha1=" },
  "secretHint": "Your Intercom app's client secret, from Basic information",
  "setup": [
    "In the Intercom Developer Hub, open your app and go to Webhooks. Set the endpoint URL to the URL below.",
    "Subscribe to these topics: conversation.user.created, conversation.user.replied.",
    "Copy the app's client secret from Basic information and paste it here. Intercom signs each notification with it.",
    "Install the Messenger with your own user id as user_id, so that each contact has it as its external_id."
  ],
  "identity": "Kairos reads your user id from the contact's external_id, which is the user_id you give the Intercom Messenger. A visitor or a lead without it is stored on its Intercom contact only.",
  "events": ["conversation.user.created", "conversation.user.replied"],
  "mapping": {
    "rules": [
      {
        "name": "New conversation",
        "match": { "topic": "conversation.user.created" },
        "event": {
          "id": "$.id",
          "type": "support_message",
          "ts": { "path": "$.created_at", "format": "unix_seconds" },
          "entities": { "user": "$.data.item.contacts.contacts[0].external_id", "intercom_contact": "$.data.item.contacts.contacts[0].id" },
          "universal_id": "$.data.item.id",
          "status": "opened",
          "properties": {
            "topic": "$.topic",
            "subject": "$.data.item.source.subject",
            "message": "$.data.item.source.body",
            "channel": "$.data.item.source.delivered_as",
            "source_type": "$.data.item.source.type",
            "author_type": "$.data.item.source.author.type",
            "conversation_state": "$.data.item.state",
            "priority": "$.data.item.priority"
          }
        }
      },
      {
        "name": "Reply",
        "match": { "topic": "conversation.user.replied" },
        "event": {
          "id": "$.id",
          "type": "support_message",
          "ts": { "path": "$.created_at", "format": "unix_seconds" },
          "entities": { "user": "$.data.item.contacts.contacts[0].external_id", "intercom_contact": "$.data.item.contacts.contacts[0].id" },
          "universal_id": "$.data.item.id",
          "status": "replied",
          "properties": {
            "topic": "$.topic",
            "message": "$.data.item.conversation_parts.conversation_parts[0].body",
            "part_type": "$.data.item.conversation_parts.conversation_parts[0].part_type",
            "author_type": "$.data.item.conversation_parts.conversation_parts[0].author.type",
            "conversation_state": "$.data.item.state",
            "priority": "$.data.item.priority"
          }
        }
      }
    ]
  },
  "samples": [
    {

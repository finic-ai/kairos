{
  "provider": "marqeta",
  "version": 1,
  "displayName": "Marqeta",
  "category": "transaction_intelligence",
  "checked": false,
  "description": "Card transactions on the cards you issue: authorizations, clearings, reversals, refunds and cardholder disputes, with the merchant, how the card was used, and the network's risk scores.",
  "verification": { "scheme": "hmac", "header": "X-Marqeta-Signature", "algorithm": "sha256", "encoding": "hex" },
  "secretHint": "The webhook's secret (20 to 50 characters)",
  "setup": [
    "Create a webhook with POST /webhooks on the Marqeta Core API (or in the Marqeta Dashboard). Set config.url to the URL below.",
    "Set config.secret to a new secret of 20 to 50 characters, set config.signature_algorithm to HMAC_SHA256, and paste the same secret here.",
    "Marqeta requires config.basic_auth_username and config.basic_auth_password: set any values. Kairos does not read them; the token in the URL and the signature prove each delivery.",
    "Subscribe to transaction.* (the events \"transaction.*\").",
    "Marqeta does not know your user id unless you chose it as the Marqeta user token. Give each user the token of their Marqeta user as a property: PUT /v1/objects with { \"type\": \"user\", \"id\": \"user_42\", \"properties\": { \"marqeta_user_token\": \"…\" } }."
  ],
  "identity": "Kairos finds the user whose marqeta_user_token property is the transaction's user_token. Without that property, a transaction is stored on its Marqeta user and card only. Marqeta sends amounts in major units (10.5 is 10.50), not in cents.",
  "events": ["transaction.*"],
  "mapping": {
    "rules": [
      {
        "name": "Authorization",
        "items": "$.transactions",
        "match": { "$$.type": ["authorization", "authorization.atm.withdrawal", "authorization.cashback", "authorization.quasi.cash", "authorization.account_verification"] },
        "event": {
          "id": "$$.token",
          "type": "card_transaction",
          "ts": "$$.created_time",
          "entities": {
            "user": { "lookup": { "property": "marqeta_user_token", "value": "$$.user_token" } },
            "marqeta_user": "$$.user_token",
            "card": "$$.card_token"
          },
          "universal_id": "$$.token",
          "status": { "path": "$$.state", "values": { "PENDING": "pending", "CLEARED": "completed", "COMPLETION": "completed", "DECLINED": "declined", "ERROR": "failed" } },
          "properties": {
            "transaction_type": "$$.type",
            "amount": "$$.amount",
            "request_amount": "$$.request_amount",
            "currency": "$$.currency_code",
            "response_code": "$$.response.code",
            "response_memo": "$$.response.memo",
            "merchant": "$$.card_acceptor.name",
            "merchant_id": "$$.card_acceptor.mid",
            "mcc": "$$.card_acceptor.mcc",
            "merchant_city": "$$.card_acceptor.city",
            "merchant_country": "$$.card_acceptor.country_code",
            "network": "$$.network",
            "transaction_risk_score": "$$.fraud.network.transaction_risk_score",
            "account_risk_score": "$$.fraud.network.account_risk_score",
            "card_present": "$$.pos.card_presence",
            "cardholder_present": "$$.pos.card_holder_presence",
            "pan_entry_mode": "$$.pos.pan_entry_mode",
            "pin_entry_mode": "$$.pos.pin_entry_mode",
            "recurring": "$$.pos.is_recurring",
            "payment_channel": "$$.transaction_metadata.payment_channel",
            "cvv_result": "$$.card_security_code_verification.response.memo",
            "three_ds_result": "$$.cardholder_authentication_data.verification_result",
            "wallet": "$$.digital_wallet_token.wallet_provider",
            "standin_reason": "$$.standin_reason"
          }
        }
      },
      {
        "name": "Clearing",
        "items": "$.transactions",
        "match": { "$$.type": ["authorization.clearing", "authorization.clearing.atm.withdrawal", "authorization.clearing.cashback", "authorization.clearing.quasi.cash"] },
        "event": {
          "id": "$$.token",
          "type": "card_transaction",
          "ts": "$$.created_time",
          "entities": {
            "user": { "lookup": { "property": "marqeta_user_token", "value": "$$.user_token" } },
            "marqeta_user": "$$.user_token",
            "card": "$$.card_token"
          },
          "universal_id": "$$.preceding_related_transaction_token",
          "status": { "path": "$$.state", "values": { "PENDING": "pending", "CLEARED": "completed", "COMPLETION": "completed", "DECLINED": "declined", "ERROR": "failed" } },
          "properties": {
            "transaction_type": "$$.type",
            "amount": "$$.amount",
            "currency": "$$.currency_code",
            "response_code": "$$.response.code",
            "merchant": "$$.card_acceptor.name",
            "mcc": "$$.card_acceptor.mcc"
          }
        }
      },
      {
        "name": "Reversal",
        "items": "$.transactions",
        "match": { "$$.type": ["authorization.reversal", "authorization.reversal.issuerexpiration"] },
        "event": {
          "id": "$$.token",
          "type": "card_transaction",
          "ts": "$$.created_time",
          "entities": {
            "user": { "lookup": { "property": "marqeta_user_token", "value": "$$.user_token" } },
            "marqeta_user": "$$.user_token",
            "card": "$$.card_token"
          },
          "universal_id": "$$.original_transaction_token",
          "status": { "path": "$$.type", "values": { "authorization.reversal": "reversed", "authorization.reversal.issuerexpiration": "expired" } },
          "properties": {
            "transaction_type": "$$.type",
            "amount": "$$.amount",
            "currency": "$$.currency_code",
            "response_code": "$$.response.code"
          }
        }
      },
      {
        "name": "Refund",
        "items": "$.transactions",
        "match": { "$$.type": ["refund", "refund.authorization", "refund.authorization.clearing"] },
        "event": {
          "id": "$$.token",
          "type": "refund",
          "ts": "$$.created_time",
          "entities": {
            "user": { "lookup": { "property": "marqeta_user_token", "value": "$$.user_token" } },
            "marqeta_user": "$$.user_token",
            "card": "$$.card_token"
          },
          "universal_id": "$$.original_transaction_token",
          "status": "refunded",
          "properties": {
            "transaction_type": "$$.type",
            "amount": "$$.amount",
            "currency": "$$.currency_code",
            "merchant": "$$.card_acceptor.name",
            "mcc": "$$.card_acceptor.mcc"
          }
        }
      },
      {
        "name": "Cardholder dispute",
        "items": "$.transactions",
        "match": { "$$.type": ["authorization.clearing.chargeback", "authorization.clearing.chargeback.completed", "authorization.clearing.chargeback.reversal"] },
        "event": {
          "id": "$$.token",
          "type": "card_dispute",
          "ts": "$$.created_time",
          "entities": {
            "user": { "lookup": { "property": "marqeta_user_token", "value": "$$.user_token" } },
            "marqeta_user": "$$.user_token",
            "card": "$$.card_token"
          },
          "universal_id": "$$.token",
          "status": { "path": "$$.type", "values": { "authorization.clearing.chargeback": "opened", "authorization.clearing.chargeback.completed": "won", "authorization.clearing.chargeback.reversal": "lost" } },
          "properties": {
            "transaction_type": "$$.type",
            "dispute_state": "$$.state",
            "amount": "$$.amount",
            "currency": "$$.currency_code",
            "disputed_transaction": "$$.preceding_related_transaction_token",
            "merchant": "$$.card_acceptor.name",
            "mcc": "$$.card_acceptor.mcc"
          }
        },
        "label": {
          "entity": "user",
          "label": { "path": "$$.type", "values": { "authorization.clearing.chargeback": "cardholder_dispute", "authorization.clearing.chargeback.completed": "cardholder_dispute_won", "authorization.clearing.chargeback.reversal": "cardholder_dispute_lost" } },
          "properties": { "transaction": "$$.token", "dispute_state": "$$.state" }
        }
      }
    ]
  },

{
  "provider": "shopify",
  "version": 1,
  "displayName": "Shopify",
  "category": "commerce",
  "checked": true,
  "description": "Orders, refunds and Shopify Payments disputes. A chargeback becomes a label on the customer who ordered.",
  "verification": { "scheme": "hmac", "header": "X-Shopify-Hmac-Sha256", "algorithm": "sha256", "encoding": "base64" },
  "secretHint": "The key from Settings › Notifications › Webhooks, or your app's client secret",
  "setup": [
    "In the Shopify admin, open Settings › Notifications › Webhooks. Create a webhook for each event below, with the format JSON, the URL below and the newest API version. For an app, subscribe to the same topics in shopify.app.toml or with webhookSubscriptionCreate.",
    "Paste the signing secret here. For webhooks made in the admin, it is the key that the Webhooks section shows (\"Your webhooks will be signed with …\"). For an app, it is the app's client secret.",
    "For an app, request access to protected customer data. Without it, Shopify leaves the customer, the email and the addresses out of the payload, and an order has no user.",
    "Disputes come from Shopify Payments only. With another payment provider, connect that provider for its disputes."
  ],
  "identity": "Kairos uses the Shopify customer id (customer.id, such as 7389154082937) as your user id: use the same id when your code asks Kairos for a decision. Refunds and disputes find their user from the order. An order with no customer (a guest checkout) is stored on its IP address only, and a dispute of it waits as No entity. If your users have their own id, change the user to a lookup: {\"lookup\": {\"property\": \"shopify_customer_id\", \"value\": \"$.customer.id\"}}.",
  "events": ["orders/create", "orders/paid", "orders/cancelled", "refunds/create", "disputes/create", "disputes/update"],
  "mapping": {
    "rules": [
      {
        "name": "Order",
        "match_headers": { "x-shopify-topic": ["orders/create", "orders/paid", "orders/cancelled"] },
        "event": {
          "id": { "path": "$.x-shopify-webhook-id", "headers": true },
          "type": "order",
          "ts": "$.updated_at",
          "entities": { "user": "$.customer.id", "ip": "$.browser_ip" },
          "universal_id": "$.id",
          "status": { "path": "$.x-shopify-topic", "headers": true, "values": { "orders/create": "created", "orders/paid": "paid", "orders/cancelled": "canceled" } },
          "properties": {
            "order_name": "$.name",
            "amount": { "path": "$.total_price", "format": "number" },
            "subtotal": { "path": "$.subtotal_price", "format": "number" },
            "discounts": { "path": "$.total_discounts", "format": "number" },
            "currency": "$.currency",
            "financial_status": "$.financial_status",
            "fulfillment_status": "$.fulfillment_status",
            "cancel_reason": "$.cancel_reason",
            "source_name": "$.source_name",
            "gateway": "$.payment_gateway_names[0]",
            "discount_code": "$.discount_codes[0].code",
            "customer_created_at": { "path": "$.customer.created_at", "format": "iso" },
            "customer_verified_email": "$.customer.verified_email",
            "customer_state": "$.customer.state",
            "user_agent": "$.client_details.user_agent",
            "accept_language": "$.client_details.accept_language",
            "billing_country": "$.billing_address.country_code",
            "billing_zip": "$.billing_address.zip",
            "shipping_country": "$.shipping_address.country_code",
            "shipping_zip": "$.shipping_address.zip",
            "landing_site": "$.landing_site",
            "referring_site": "$.referring_site",
            "test": "$.test",
            "shop": { "path": "$.x-shopify-shop-domain", "headers": true }
          }
        }
      },
      {
        "name": "Refund",
        "match_headers": { "x-shopify-topic": "refunds/create" },
        "event": {
          "id": { "path": "$.x-shopify-webhook-id", "headers": true },
          "type": "refund",
          "ts": "$.created_at",
          "entities": { "user": { "record": "$.order_id" } },
          "universal_id": "$.order_id",
          "status": "refunded",
          "properties": {
            "refund_id": "$.id",
            "amount": { "path": "$.transactions[0].amount", "format": "number" },
            "gateway": "$.transactions[0].gateway",
            "transaction_status": "$.transactions[0].status",
            "note": "$.note",
            "restock": "$.restock"
          }
        }
      },
      {
        "name": "Dispute opened",
        "match_headers": { "x-shopify-topic": "disputes/create" },
        "event": {
          "id": { "path": "$.x-shopify-webhook-id", "headers": true },
          "type": "dispute_opened",
          "ts": "$.initiated_at",
          "entities": { "user": { "record": "$.order_id" } },
          "universal_id": "$.order_id",
          "status": "disputed",
          "properties": {
            "dispute_id": "$.id",
            "dispute_type": "$.type",
            "reason": "$.reason",
            "network_reason_code": "$.network_reason_code",
            "amount": { "path": "$.amount", "format": "number" },
            "currency": "$.currency",
            "evidence_due_by": "$.evidence_due_by"
          }
        }
      },
      {
        "name": "Chargeback",
        "match_headers": { "x-shopify-topic": "disputes/create" },
        "match": { "type": "chargeback" },
        "label": {
          "entity": "user",
          "id": { "record": "$.order_id" },
          "label": "chargeback",
          "ts": "$.initiated_at",
          "properties": { "dispute_id": "$.id", "reason": "$.reason" }
        }
      },
      {
        "name": "Dispute closed",
        "match_headers": { "x-shopify-topic": "disputes/update" },
        "match": { "status": ["won", "lost", "accepted", "charge_refunded"] },
        "event": {
          "id": { "path": "$.x-shopify-webhook-id", "headers": true },
          "type": "dispute_closed",
          "ts": { "path": "$.finalized_on" },
          "entities": { "user": { "record": "$.order_id" } },
          "universal_id": "$.order_id",
          "status": { "path": "$.status", "values": { "won": "dispute_won", "lost": "dispute_lost", "accepted": "dispute_lost", "charge_refunded": "dispute_lost" } },
          "properties": {
            "dispute_id": "$.id",
            "dispute_type": "$.type",
            "outcome": "$.status",
            "reason": "$.reason",
            "amount": { "path": "$.amount", "format": "number" },
            "currency": "$.currency"
          }
        }
      },
      {
        "name": "Chargeback closed",
        "match_headers": { "x-shopify-topic": "disputes/update" },
        "match": { "type": "chargeback", "status": ["won", "lost", "accepted", "charge_refunded"] },
        "label": {
          "entity": "user",
          "id": { "record": "$.order_id" },
          "label": { "path": "$.status", "values": { "won": "dispute_won", "lost": "chargeback_lost", "accepted": "chargeback_lost", "charge_refunded": "chargeback_lost" } },
          "ts": { "path": "$.finalized_on" },
          "properties": { "dispute_id": "$.id", "outcome": "$.status" }
        }
      }
    ]
  },

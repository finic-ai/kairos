{
  "provider": "stripe",
  "version": 1,
  "displayName": "Stripe",
  "category": "payments",
  "checked": false,
  "description": "Payments, refunds and disputes. A dispute becomes a chargeback label on the user who paid.",
  "verification": { "scheme": "stripe" },
  "secretHint": "The endpoint's signing secret, whsec_…",
  "setup": [
    "In Stripe, open Developers › Webhooks (or Workbench › Webhooks) and add an endpoint with the URL below.",
    "Select these events: payment_intent.succeeded, payment_intent.payment_failed, payment_intent.processing, payment_intent.canceled, charge.refunded, charge.dispute.created, charge.dispute.closed.",
    "Reveal the endpoint's signing secret (whsec_…) and paste it here.",
    "Put your own user id in the metadata of each PaymentIntent you create: metadata: { user_id: \"user_42\" }. Refunds and disputes do not carry it; Kairos finds their user from the payment they belong to."
  ],
  "identity": "Kairos reads your user id from metadata.user_id on the PaymentIntent. Without it, a payment is stored on its Stripe customer only, and a refund or a dispute of that payment has no user to go to.",
  "events": [
    "payment_intent.succeeded",
    "payment_intent.payment_failed",
    "payment_intent.processing",
    "payment_intent.canceled",
    "charge.refunded",
    "charge.dispute.created",
    "charge.dispute.closed"
  ],
  "mapping": {
    "rules": [
      {
        "name": "Payment",
        "match": { "type": ["payment_intent.succeeded", "payment_intent.payment_failed", "payment_intent.processing", "payment_intent.canceled"] },
        "event": {
          "id": "$.id",
          "type": "payment",
          "ts": { "path": "$.created", "format": "unix_seconds" },
          "entities": { "user": "$.data.object.metadata.user_id", "stripe_customer": "$.data.object.customer" },
          "universal_id": "$.data.object.id",
          "status": {
            "path": "$.type",
            "values": {
              "payment_intent.succeeded": "completed",
              "payment_intent.payment_failed": "failed",
              "payment_intent.processing": "pending",
              "payment_intent.canceled": "canceled"
            }
          },
          "properties": {
            "amount_minor": "$.data.object.amount",
            "currency": "$.data.object.currency",
            "payment_method_type": "$.data.object.payment_method_types[0]",
            "decline_code": "$.data.object.last_payment_error.decline_code",
            "failure_code": "$.data.object.last_payment_error.code",
            "description": "$.data.object.description"
          }
        }
      },
      {
        "name": "Refund",
        "match": { "type": "charge.refunded" },
        "event": {
          "id": "$.id",
          "type": "refund",
          "ts": { "path": "$.created", "format": "unix_seconds" },
          "entities": { "user": { "record": "$.data.object.payment_intent" }, "stripe_customer": "$.data.object.customer" },
          "universal_id": "$.data.object.payment_intent",
          "status": "refunded",
          "properties": {
            "amount_refunded_minor": "$.data.object.amount_refunded",
            "amount_minor": "$.data.object.amount",
            "currency": "$.data.object.currency",
            "fully_refunded": "$.data.object.refunded"
          }
        }
      },
      {
        "name": "Dispute opened",
        "match": { "type": "charge.dispute.created" },
        "event": {
          "id": "$.id",
          "type": "dispute_opened",
          "ts": { "path": "$.created", "format": "unix_seconds" },
          "entities": { "user": { "record": "$.data.object.payment_intent" } },
          "universal_id": "$.data.object.payment_intent",
          "status": "disputed",
          "properties": {
            "dispute_id": "$.data.object.id",
            "reason": "$.data.object.reason",
            "amount_minor": "$.data.object.amount",
            "currency": "$.data.object.currency"
          }
        },
        "label": { "entity": "user", "label": "chargeback", "properties": { "dispute_id": "$.data.object.id", "reason": "$.data.object.reason" } }
      },
      {
        "name": "Dispute closed",
        "match": { "type": "charge.dispute.closed" },
        "event": {
          "id": "$.id",
          "type": "dispute_closed",
          "ts": { "path": "$.created", "format": "unix_seconds" },
          "entities": { "user": { "record": "$.data.object.payment_intent" } },
          "universal_id": "$.data.object.payment_intent",
          "status": { "path": "$.data.object.status", "values": { "won": "dispute_won", "lost": "dispute_lost" }, "default": "dispute_closed" },
          "properties": {
            "dispute_id": "$.data.object.id",
            "reason": "$.data.object.reason",
            "dispute_status": "$.data.object.status",
            "amount_minor": "$.data.object.amount",
            "currency": "$.data.object.currency"
          }
        },
        "label": {
          "entity": "user",
          "label": { "path": "$.data.object.status", "values": { "won": "dispute_won", "lost": "chargeback_lost" }, "default": "dispute_closed" },
          "properties": { "dispute_id": "$.data.object.id", "reason": "$.data.object.reason" }
        }
      }
    ]
  },
  "samples": [

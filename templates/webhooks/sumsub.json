{
  "provider": "sumsub",
  "version": 1,
  "displayName": "Sumsub",
  "category": "identity_verification",
  "checked": false,
  "description": "Identity checks: each stage of an applicant's verification, and the result. The user gets kyc_status, and a final rejection becomes a label.",
  "verification": { "scheme": "hmac", "header": "X-Payload-Digest", "algorithm": "sha256", "encoding": "hex" },
  "secretHint": "The webhook's secret key, from the Webhook manager",
  "setup": [
    "In the Sumsub Dashboard, open Dev space › Webhooks › Webhook manager and create a webhook. Set the receiver type to HTTP address and the target to the URL below.",
    "Select these types: applicantCreated, applicantPending, applicantOnHold, applicantPrechecked, applicantAwaitingUser, applicantAwaitingService, applicantReset, applicantReviewed.",
    "Set the signature algorithm to SHA256. A webhook made before SHA256 became the default can still sign with SHA1: edit it and choose SHA256.",
    "Copy the webhook's secret key and paste it here.",
    "Give your own user id as the externalUserId when you create each applicant or SDK access token."
  ],
  "identity": "Kairos reads your user id from externalUserId. Give your own user id (such as user_42) when you create the applicant or the SDK access token. Without it, Sumsub makes an id of its own, and the checks are stored on a user that your decisions do not know.",
  "events": [
    "applicantCreated",
    "applicantPending",
    "applicantOnHold",
    "applicantPrechecked",
    "applicantAwaitingUser",
    "applicantAwaitingService",
    "applicantReset",
    "applicantReviewed"
  ],
  "mapping": {
    "rules": [
      {
        "name": "Check status",
        "match": {
          "type": ["applicantCreated", "applicantPending", "applicantOnHold", "applicantPrechecked", "applicantAwaitingUser", "applicantAwaitingService", "applicantReset"]
        },
        "event": {
          "id": { "join": ["$.applicantId", "$.type", "$.createdAtMs"] },
          "type": "identity_check",
          "ts": "$.createdAtMs",
          "entities": { "user": "$.externalUserId", "sumsub_applicant": "$.applicantId" },
          "universal_id": "$.applicantId",
          "status": {
            "path": "$.type",
            "values": { "applicantCreated": "started", "applicantPending": "pending", "applicantOnHold": "on_hold", "applicantPrechecked": "prechecked", "applicantAwaitingUser": "awaiting_user", "applicantAwaitingService": "awaiting_service", "applicantReset": "reset" }
          },
          "properties": {
            "level": "$.levelName",
            "review_status": "$.reviewStatus",
            "review_mode": "$.reviewMode",
            "applicant_type": "$.applicantType",
            "sandbox": "$.sandboxMode",
            "test": "$.testMode"
          },
          "set": {
            "user": {
              "kyc_status": {
                "path": "$.type",
                "values": { "applicantCreated": "started", "applicantPending": "pending", "applicantOnHold": "on_hold", "applicantPrechecked": "prechecked", "applicantAwaitingUser": "awaiting_user", "applicantAwaitingService": "awaiting_service", "applicantReset": "reset" }
              },
              "kyc_level": "$.levelName"
            }
          }
        }
      },
      {
        "name": "Approved",
        "match": { "type": "applicantReviewed", "reviewResult.reviewAnswer": "GREEN" },
        "event": {
          "id": { "join": ["$.applicantId", "$.type", "$.createdAtMs"] },
          "type": "identity_check",
          "ts": "$.createdAtMs",
          "entities": { "user": "$.externalUserId", "sumsub_applicant": "$.applicantId" },
          "universal_id": "$.applicantId",
          "status": "approved",
          "properties": {
            "level": "$.levelName",
            "review_answer": "$.reviewResult.reviewAnswer",
            "review_mode": "$.reviewMode",
            "applicant_type": "$.applicantType",
            "sandbox": "$.sandboxMode",
            "test": "$.testMode"
          },
          "set": { "user": { "kyc_status": "approved", "kyc_level": "$.levelName" } }
        }
      },
      {
        "name": "Resubmission requested",
        "match": { "type": "applicantReviewed", "reviewResult.reviewAnswer": "RED", "reviewResult.reviewRejectType": "RETRY" },
        "event": {
          "id": { "join": ["$.applicantId", "$.type", "$.createdAtMs"] },
          "type": "identity_check",
          "ts": "$.createdAtMs",
          "entities": { "user": "$.externalUserId", "sumsub_applicant": "$.applicantId" },
          "universal_id": "$.applicantId",
          "status": "resubmission_requested",
          "properties": {
            "level": "$.levelName",
            "review_answer": "$.reviewResult.reviewAnswer",
            "reject_type": "$.reviewResult.reviewRejectType",
            "reject_label": "$.reviewResult.rejectLabels[0]",
            "reject_labels": "$.reviewResult.rejectLabels",
            "applicant_type": "$.applicantType",
            "sandbox": "$.sandboxMode",
            "test": "$.testMode"
          },
          "set": { "user": { "kyc_status": "resubmission_requested", "kyc_level": "$.levelName" } }
        }
      },
      {
        "name": "Rejected",
        "match": { "type": "applicantReviewed", "reviewResult.reviewAnswer": "RED", "reviewResult.reviewRejectType": "FINAL" },
        "event": {
          "id": { "join": ["$.applicantId", "$.type", "$.createdAtMs"] },
          "type": "identity_check",
          "ts": "$.createdAtMs",
          "entities": { "user": "$.externalUserId", "sumsub_applicant": "$.applicantId" },
          "universal_id": "$.applicantId",
          "status": "rejected",
          "properties": {
            "level": "$.levelName",
            "review_answer": "$.reviewResult.reviewAnswer",
            "reject_type": "$.reviewResult.reviewRejectType",
            "reject_label": "$.reviewResult.rejectLabels[0]",
            "reject_labels": "$.reviewResult.rejectLabels",
            "applicant_type": "$.applicantType",
            "sandbox": "$.sandboxMode",
            "test": "$.testMode"
          },
          "set": { "user": { "kyc_status": "rejected", "kyc_level": "$.levelName" } }
        },
        "label": {
          "entity": "user",
          "label": "kyc_rejected",
          "properties": { "reject_labels": "$.reviewResult.rejectLabels", "level": "$.levelName" }
        }
      }
    ]
  },
  "samples": [

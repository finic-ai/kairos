{
  "provider": "fingerprint",
  "version": 1,
  "displayName": "Fingerprint",
  "category": "device_intelligence",
  "checked": false,
  "description": "Every identification: the device, its IP, and the bot, VPN, proxy, tampering and velocity signals Fingerprint found.",
  "verification": { "scheme": "hmac", "header": "FPJS-Event-Signature", "algorithm": "sha256", "encoding": "hex", "prefix": "v1=" },
  "secretHint": "The webhook's signing key, from the webhook's settings",
  "setup": [
    "In the Fingerprint dashboard, open App settings › Webhooks and add a webhook with the URL below.",
    "Turn on webhook signatures for it, and paste the signing key here.",
    "In your page or app, pass your own user id to Fingerprint as the linkedId of each identification request, such as fp.get({ linkedId: \"user_42\" }). To say what the person was doing, add tag: { action: \"login\" }."
  ],
  "identity": "Kairos reads your user id from linked_id, which you set on each identification request. Without it, an identification is stored on its device and IP only.",
  "events": ["identification"],
  "mapping": {
    "rules": [
      {
        "name": "Identification",
        "event": {
          "id": "$.event_id",
          "type": "device_identified",
          "ts": { "path": "$.timestamp", "format": "unix_ms" },
          "entities": { "user": "$.linked_id", "device": "$.identification.visitor_id", "ip": "$.ip_address" },
          "properties": {
            "action": "$.tags.action",
            "url": "$.url",
            "confidence": "$.identification.confidence.score",
            "visitor_found": "$.identification.visitor_found",
            "bot": "$.bot",
            "vpn": "$.vpn",
            "vpn_confidence": "$.vpn_confidence",
            "proxy": "$.proxy",
            "proxy_type": "$.proxy_details.proxy_type",
            "tor": "$.ip_blocklist.tor_node",
            "ip_attack_source": "$.ip_blocklist.attack_source",
            "tampering": "$.tampering",
            "anti_detect_browser": "$.tampering_details.anti_detect_browser",
            "incognito": "$.incognito",
            "virtual_machine": "$.virtual_machine",
            "emulator": "$.emulator",
            "jailbroken": "$.jailbroken",
            "root_apps": "$.root_apps",
            "frida": "$.frida",
            "developer_tools": "$.developer_tools",
            "location_spoofing": "$.location_spoofing",
            "replayed": "$.replayed",
            "high_activity_device": "$.high_activity_device",
            "browser": "$.browser_details.browser_name",
            "os": "$.browser_details.os",
            "ip_country": "$.ip_info.v4.geolocation.country_code",
            "ip_city": "$.ip_info.v4.geolocation.city_name",
            "asn_name": "$.ip_info.v4.asn_name",
            "asn_type": "$.ip_info.v4.asn_type",
            "datacenter": "$.ip_info.v4.datacenter_result",
            "distinct_ips_24h": "$.velocity.distinct_ip.24_hours",
            "distinct_countries_24h": "$.velocity.distinct_country.24_hours",
            "events_24h": "$.velocity.events.24_hours",
            "users_on_device_24h": "$.velocity.distinct_linked_id.24_hours"
          },
          "set_once": { "device": { "first_seen_at": "$.identification.first_seen_at" } }
        }
      }
    ]
  },
  "samples": [

{
  "provider": "zendesk",
  "version": 1,
  "displayName": "Zendesk",
  "category": "customer_support",
  "checked": false,
  "description": "Support tickets: each new ticket, each message from the requester, and each status change. Zendesk users are linked to your users by their external id.",
  "verification": { "scheme": "timestamped", "header": "X-Zendesk-Webhook-Signature", "timestampHeader": "X-Zendesk-Webhook-Signature-Timestamp", "join": "", "algorithm": "sha256", "encoding": "base64" },
  "secretHint": "The webhook's signing secret, from Reveal secret",
  "setup": [
    "In Zendesk Admin Center, open Apps and integrations › Webhooks › Webhooks and create a webhook. Choose Zendesk events as the way to connect.",
    "Subscribe to these events: Ticket created, Comment added, Status changed, User created, User external ID changed. Set the endpoint URL to the URL below, the method to POST and the format to JSON.",
    "After you create the webhook, open it, click Reveal secret, and paste the signing secret here.",
    "Give each Zendesk user your own user id as their external_id (Zendesk's single sign-on and the Users API both set it)."
  ],
  "identity": "A ticket names its requester by Zendesk user id only. When a Zendesk user is created or their external_id changes, Kairos stores their Zendesk id on your user (zendesk_user_id), and finds the user of each later ticket from it. A ticket from a Zendesk user with no external_id is stored on the Zendesk user only.",
  "events": [
    "zen:event-type:ticket.created",
    "zen:event-type:ticket.comment_added",
    "zen:event-type:ticket.status_changed",
    "zen:event-type:user.created",
    "zen:event-type:user.external_id_changed"
  ],
  "mapping": {
    "rules": [
      {
        "name": "Zendesk user",
        "match": { "type": ["zen:event-type:user.created", "zen:event-type:user.external_id_changed"] },
        "event": {
          "id": "$.id",
          "type": "support_user_linked",
          "ts": "$.time",
          "entities": { "user": "$.detail.external_id", "zendesk_user": "$.detail.id" },
          "properties": { "role": "$.detail.role" },
          "set": { "user": { "zendesk_user_id": "$.detail.id" } }
        }
      },
      {
        "name": "Ticket created",
        "match": { "type": "zen:event-type:ticket.created" },
        "event": {
          "id": "$.id",
          "type": "support_ticket",
          "ts": "$.time",
          "entities": {
            "user": { "lookup": { "property": "zendesk_user_id", "value": "$.detail.requester_id" } },
            "zendesk_user": "$.detail.requester_id"
          },
          "universal_id": "$.detail.id",
          "status": "opened",
          "properties": {
            "subject": "$.detail.subject",
            "message": "$.detail.description",
            "channel": "$.detail.via.channel",
            "priority": "$.detail.priority",
            "ticket_type": "$.detail.type"
          }
        }
      },
      {
        "name": "Message from the requester",
        "match": { "type": "zen:event-type:ticket.comment_added", "event.comment.author.is_staff": false },
        "event": {
          "id": "$.id",
          "type": "support_message",
          "ts": "$.time",
          "entities": {
            "user": { "lookup": { "property": "zendesk_user_id", "value": "$.event.comment.author.id" } },
            "zendesk_user": "$.event.comment.author.id"
          },
          "universal_id": "$.detail.id",
          "status": "replied",
          "properties": {
            "message": "$.event.comment.body",
            "public": "$.event.comment.is_public",
            "channel": "$.detail.via.channel",
            "subject": "$.detail.subject"
          }
        }
      },
      {
        "name": "Status changed",
        "match": { "type": "zen:event-type:ticket.status_changed" },
        "event": {
          "id": "$.id",
          "type": "support_ticket",
          "ts": "$.time",
          "entities": {
            "user": { "lookup": { "property": "zendesk_user_id", "value": "$.detail.requester_id" } },
            "zendesk_user": "$.detail.requester_id"
          },
          "universal_id": "$.detail.id",
          "status": { "path": "$.event.current", "values": { "NEW": "new", "OPEN": "open", "PENDING": "pending", "HOLD": "on_hold", "SOLVED": "solved", "CLOSED": "closed" } },
          "properties": {
            "previous_status": "$.event.previous",
            "priority": "$.detail.priority",
            "ticket_type": "$.detail.type"
          }
        }
      }
    ]
  },
  "samples": [

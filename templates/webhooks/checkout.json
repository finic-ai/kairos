{
  "provider": "checkout",
  "version": 1,
  "displayName": "Checkout.com",
  "category": "payments",
  "checked": false,
  "description": "Card payments, refunds and disputes. A dispute becomes a chargeback label on the user who paid.",
  "verification": { "scheme": "hmac", "header": "Cko-Signature", "algorithm": "sha256", "encoding": "hex" },
  "secretHint": "The workflow's signature key, from its webhook action",
  "setup": [
    "In the Checkout.com Dashboard, open Developers › Workflows and add a workflow with a webhook action that sends to the URL below.",
    "Set its signature key (or copy the one that the Dashboard made) and paste it here.",
    "Add these event types to the workflow: payment_approved, payment_declined, payment_pending, payment_captured, payment_voided, payment_canceled, payment_expired, payment_refunded, dispute_received, dispute_won, dispute_lost, dispute_accepted, dispute_expired.",
    "Put your own user id in the metadata of each payment you request: \"metadata\": { \"user_id\": \"user_42\" }. Refunds and disputes do not carry it; Kairos finds their user from the payment they belong to."
  ],
  "identity": "Kairos reads your user id from data.metadata.user_id on the payment. Without it, a payment is stored on its Checkout.com customer, card and IP only, and a refund or a dispute of that payment has no user to go to.",
  "events": [
    "payment_approved",
    "payment_declined",
    "payment_pending",
    "payment_captured",
    "payment_voided",
    "payment_canceled",
    "payment_expired",
    "payment_refunded",
    "dispute_received",
    "dispute_won",
    "dispute_lost",
    "dispute_accepted",
    "dispute_expired"
  ],
  "mapping": {
    "rules": [
      {
        "name": "Payment",
        "match": { "type": ["payment_approved", "payment_declined", "payment_pending"] },
        "event": {
          "id": "$.id",
          "type": "payment",
          "ts": "$.created_on",
          "entities": { "user": "$.data.metadata.user_id", "checkout_customer": "$.data.customer.id", "card": "$.data.source.fingerprint", "ip": "$.data.payment_ip" },
          "universal_id": "$.data.id",
          "status": { "path": "$.type", "values": { "payment_approved": "approved", "payment_declined": "declined", "payment_pending": "pending" } },
          "properties": {
            "amount_minor": "$.data.amount",
            "currency": "$.data.currency",
            "reference": "$.data.reference",
            "payment_type": "$.data.payment_type",
            "response_code": "$.data.response_code",
            "response_summary": "$.data.response_summary",
            "risk_flagged": "$.data.risk.flagged",
            "risk_score": "$.data.risk.score",
            "source_type": "$.data.source.type",
            "wallet": "$.data.source.card_wallet_type",
            "card_scheme": "$.data.source.scheme",
            "card_bin": "$.data.source.bin",
            "card_last4": "$.data.source.last_4",
            "card_type": "$.data.source.card_type",
            "card_category": "$.data.source.card_category",
            "issuer": "$.data.source.issuer",
            "issuer_country": "$.data.source.issuer_country",
            "avs_check": "$.data.source.avs_check",
            "cvv_check": "$.data.source.cvv_check",
            "three_ds_challenged": "$.data['3ds'].challenged",
            "three_ds_downgraded": "$.data['3ds'].downgraded",
            "three_ds_eci": "$.data['3ds'].eci"
          }
        }
      },
      {
        "name": "Payment update",
        "match": { "type": ["payment_captured", "payment_voided", "payment_canceled", "payment_expired"] },
        "event": {
          "id": "$.id",
          "type": "payment",
          "ts": "$.created_on",
          "entities": { "user": { "record": "$.data.id" } },
          "universal_id": "$.data.id",
          "status": { "path": "$.type", "values": { "payment_captured": "completed", "payment_voided": "voided", "payment_canceled": "canceled", "payment_expired": "expired" } },
          "properties": {
            "amount_minor": "$.data.amount",
            "currency": "$.data.currency",
            "reference": "$.data.reference",
            "response_code": "$.data.response_code",
            "response_summary": "$.data.response_summary"
          }
        }
      },
      {
        "name": "Refund",
        "match": { "type": "payment_refunded" },
        "event": {
          "id": "$.id",
          "type": "refund",
          "ts": "$.created_on",
          "entities": { "user": { "record": "$.data.id" } },
          "universal_id": "$.data.id",
          "status": "refunded",
          "properties": {
            "amount_refunded_minor": "$.data.amount",
            "currency": "$.data.currency",
            "total_refunded_minor": "$.data.balances.total_refunded",
            "available_to_refund_minor": "$.data.balances.available_to_refund"
          }
        }
      },
      {
        "name": "Dispute opened",
        "match": { "type": "dispute_received" },
        "event": {
          "id": "$.id",
          "type": "dispute_opened",
          "ts": "$.created_on",
          "entities": { "user": { "record": "$.data.payment_id" } },
          "universal_id": "$.data.payment_id",
          "status": "disputed",
          "properties": {
            "dispute_id": "$.data.id",
            "category": "$.data.category",
            "reason_code": "$.data.reason_code",
            "amount_minor": "$.data.amount",
            "currency": "$.data.currency"
          }
        },
        "label": { "entity": "user", "label": "chargeback", "properties": { "dispute_id": "$.data.id", "category": "$.data.category" } }
      },
      {
        "name": "Dispute closed",
        "match": { "type": ["dispute_won", "dispute_lost", "dispute_accepted", "dispute_expired"] },
        "event": {
          "id": "$.id",
          "type": "dispute_closed",
          "ts": "$.created_on",
          "entities": { "user": { "record": "$.data.payment_id" } },
          "universal_id": "$.data.payment_id",
          "status": { "path": "$.type", "values": { "dispute_won": "dispute_won", "dispute_lost": "dispute_lost", "dispute_accepted": "dispute_lost", "dispute_expired": "dispute_lost" } },
          "properties": {
            "dispute_id": "$.data.id",
            "outcome": "$.type",
            "category": "$.data.category",
            "amount_minor": "$.data.amount",
            "currency": "$.data.currency"
          }
        },
        "label": {
          "entity": "user",
          "label": { "path": "$.type", "values": { "dispute_won": "dispute_won", "dispute_lost": "chargeback_lost", "dispute_accepted": "chargeback_lost", "dispute_expired": "chargeback_lost" } },
          "properties": { "dispute_id": "$.data.id", "outcome": "$.type" }
        }
      }
    ]
  },

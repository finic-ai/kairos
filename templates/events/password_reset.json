{
  "type": "password_reset",
  "description": "A password was reset. Send one event type per kind of credential change; they are rare, so they are kept in full however old they are.",
  "entities": {
    "user": {
      "description": "Whose password.",
      "required": true
    },
    "device": {
      "description": "The device the reset came from.",
      "required": false
    },
    "ip": {
      "description": "The IP address the reset came from.",
      "required": false
    }
  },
  "properties": {
    "ip_country": {
      "type": "string",
      "description": "Country of the IP address."
    },
    "channel": {
      "type": "string",
      "description": "How the reset was confirmed.",
      "enum": [
        "email",
        "sms",
        "support"
      ]
    }
  },
  "example": {
    "userId": "user_123",
    "deviceId": "dev_41",
    "ipId": "198.51.100.20",
    "ip_country": "RO",
    "channel": "email"
  }
}

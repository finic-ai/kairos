# Copy this file to .env. The server, the examples and the evaluation scripts read .env when
# they start through pnpm (pnpm api, pnpm example, pnpm eval:replay). A value set in the
# shell wins over the file.

# Grayson API key from portal.finic.ai/keys. The server needs it. The evaluation suite
# needs it only for a request that is not in packages/eval/cache.
GRAYSON_API_KEY=

# Server (optional): set to "invite" so that a new account needs an invite link.
KAIROS_SIGNUP=
# Server (optional): set to 1 when the server is behind a proxy that sets X-Forwarded-For.
# Without it, the IP limit of an API key is compared with the address of the proxy.
KAIROS_TRUST_PROXY=
# Server (optional): Supabase Auth. Sign-in through Supabase is offered only when both values are set.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# OAuth providers that are enabled in the Supabase project, for example google,github.
SUPABASE_PROVIDERS=
# Server (optional): Amazon Cognito. Set all five, and people sign in only through the Cognito
# managed login page (email and password with two-factor authentication, Google, and other
# providers of the user pool): Kairos then keeps no passwords. The app client needs a secret, the
# authorization code grant, and <KAIROS_PUBLIC_URL>/auth/cognito/callback as a callback URL.
# The managed login domain, for example https://kairos.auth.us-east-1.amazoncognito.com.
COGNITO_DOMAIN=
# The user pool, for example https://cognito-idp.us-east-1.amazonaws.com/us-east-1_AbC123.
COGNITO_ISSUER=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
# Identity providers of the user pool that get a button of their own, for example Google.
COGNITO_PROVIDERS=
# Where people open Kairos, for example https://kairos.example.com (http://localhost:5273 with pnpm console).
KAIROS_PUBLIC_URL=
# Server: encrypts the signing secrets of webhooks. 32 bytes: make one with `openssl rand -base64 32`.
# Necessary for webhooks with DATABASE_URL, and keep it: the secrets cannot be read with another key.
# With the embedded Postgres and no value, the server makes one and keeps it in apps/server/.data.
KAIROS_ENCRYPTION_KEY=
# Server (optional): opens GET /internal/jobs/drain to a scheduler that sends "Authorization: Bearer <CRON_SECRET>".
# Needed on Vercel for webhook retries (Vercel Cron sends it). At least 16 characters: openssl rand -hex 32.
CRON_SECRET=
# Vercel build (optional): the schedule of that cron. Default every minute; on the Hobby plan use a daily one, such as 0 3 * * *.
KAIROS_CRON_SCHEDULE=
# Server (optional, development only): set to 1 so that webhooks can call http:// and local addresses.
KAIROS_WEBHOOKS_ALLOW_PRIVATE=
# Server (optional): a Postgres to use, for example postgres://user:password@localhost:5432/kairos.
# Without it the server starts its own embedded Postgres, so there is nothing to install.
DATABASE_URL=
# Server (optional): whether the server applies migrations when it starts. Default: yes with the
# embedded Postgres, no with DATABASE_URL. 0: never; a server on a database that is behind does not
# start, and `pnpm db:migrate` (or `node migrate.mjs` in a built server) applies them. Set 0 in
# development to keep a server that reloads on changes from applying a migration that is still
# being written. 1: always.
KAIROS_MIGRATE_ON_START=
# Server (optional): where background jobs run (webhook deliveries, automatic decisions, workflow
# runs, queue rules, cleanup).
# "inline" (default): in the API process. "separate": the API only enqueues them; start `pnpm worker`
# (or `node worker.mjs` in a built server) to run them.
KAIROS_WORKER=
# Server (optional): where the embedded Postgres keeps its files, and its port.
# Defaults: apps/server/.data/postgres2 and 54329.
KAIROS_DATA_DIR=
KAIROS_PG_PORT=
PORT=8787

# Deployment (see docs/self-hosting/deployment.md). The Docker image sets the three paths itself, and
# the Vercel build needs none of them. They are for a server built with pnpm build:standalone.
# The built console (apps/server/dist/console). When set, the server also serves the console.
KAIROS_CONSOLE=
# The SQL migrations and the templates, when they are not in their place in the repository.
KAIROS_MIGRATIONS=
KAIROS_TEMPLATES=
# docker compose only: the password of the Postgres that it starts. Default kairos.
POSTGRES_PASSWORD=

# Examples and pnpm eval:replay: a secret key (ksk_…) of the workspace they write to.
# Make one in the console: Settings › API keys.
KAIROS_API_KEY=
# Where the examples find the server. Default http://localhost:8787.
KAIROS_URL=

# Console (optional, for development): set to 1 to keep "Get started" in the sidebar and as the
# first page, also when every step is done or it was removed. Read when the console starts:
#   VITE_KAIROS_SHOW_GET_STARTED=1 pnpm console
VITE_KAIROS_SHOW_GET_STARTED=
